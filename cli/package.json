{
  "name": "@antelopejs/cloud",
  "version": "0.1.1",
  "description": "AntelopeJS Cloud command-line client",
  "keywords": [
    "antelopejs",
    "cli",
    "cloud",
    "deploy"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/cloud-sdk.git",
    "directory": "cli"
  },
  "bin": {
    "ajs-cloud": "dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./command": {
      "types": "./dist/command.d.ts",
      "default": "./dist/command.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm run sdk && rimraf dist && tsc",
    "lint": "oxlint --type-aware --max-warnings=0",
    "prepack": "pnpm run build",
    "test": "pnpm run build && rimraf dist-test && tsc -p test && node --test 'dist-test/test/**/*.test.js'",
    "typecheck": "pnpm run sdk && tsc --noEmit",
    "release": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test && release-it",
    "sdk": "pnpm --dir ../sdk run build",
    "lint:fix": "oxlint --type-aware --fix && oxfmt .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@antelopejs/cloud-sdk": ">=0.1.0 <0.2.0",
    "commander": "^13.1.0",
    "ignore": "^7.0.5",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@antelopejs/core": "~1.23.0",
    "@antelopejs/tooling-configs": ">=0.6.0 <0.7.0",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.19.15",
    "@types/tar-stream": "^3.1.4",
    "busboy": "^1.6.0",
    "oxfmt": "^0.77.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@antelopejs/core": "~1.23.0",
    "commander": ">=13 <15"
  },
  "peerDependenciesMeta": {
    "commander": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.20.0"
}
