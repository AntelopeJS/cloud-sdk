{
  "name": "@antelopejs/cloud-sdk",
  "version": "0.1.5",
  "description": "Typed client for the AntelopeJS Cloud API",
  "keywords": [
    "antelopejs",
    "api",
    "cloud",
    "sdk"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/cloud-sdk.git",
    "directory": "sdk"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "openapi"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/api-error.d.ts",
      "default": "./dist/api-error.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "generate": "openapi-typescript openapi/cloud.openapi.yaml -o src/generated/cloud-api.ts",
    "build": "pnpm run generate && rimraf dist && tsc",
    "check:generated": "pnpm run generate && git diff --exit-code -- src/generated/cloud-api.ts",
    "lint": "oxlint --type-aware --max-warnings=0",
    "prepack": "pnpm run build",
    "test": "pnpm run build && rimraf dist-test && tsc -p test && node --test 'dist-test/test/**/*.test.js'",
    "typecheck": "tsc --noEmit",
    "release": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test && release-it",
    "lint:fix": "oxlint --type-aware --fix && oxfmt .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": ">=0.6.0 <0.7.0",
    "@types/node": "^22.19.15",
    "openapi-typescript": "^7.9.1",
    "oxfmt": "^0.77.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.20.0"
}
