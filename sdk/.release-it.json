{
  "git": {
    "commitMessage": "chore(release): @antelopejs/cloud-sdk v${version}",
    "tagName": "cloud-sdk-v${version}",
    "requireCommits": true,
    "commitsPath": "."
  },
  "github": {
    "release": true,
    "releaseName": "@antelopejs/cloud-sdk v${version}"
  },
  "hooks": {
    "after:bump": "git add CHANGELOG.md && pnpm --workspace-root run sync && git add ../cli/README.md"
  },
  "plugins": {
    "release-it-changelogen": {
      "disableVersion": true
    }
  },
  "npm": {
    "skipChecks": true
  }
}
